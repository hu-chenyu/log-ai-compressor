# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
venv/
.mypy_cache/

# 测试与覆盖率
.pytest_cache/
.coverage
# pytest-xdist 并行模式留的分片，跑一次测试就会攒下一堆
# （这行注释原来写在行尾，而 git 只把**行首**的 # 当注释 —— 整条规则连同
#  后面的空格和中文一起变成了模式的一部分，于是从来没有生效过。
#  第四轮外部复核实测：`git check-ignore .coverage.host.12345` 返回 1。
#  一条写了却从不生效的忽略规则比不写更糟：它让人以为工作区是干净的。）
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
# CI 在 mcp 不可用时临时生成的覆盖率配置
.coveragerc.ci

# 基准数据集（Loghub 2.0 原始日志，几十 MB，不入库）
data/
!data/.gitkeep

# 工具产物
*.log.tmp
perf_bench_*.log

# CLI 默认报告：run 不带 -o 时写在输入日志旁边，compare 不带 -o 时写在当前目录。
# 后缀清单对着 cli.py::_SUFFIX_FORMAT —— 那边加了新格式，这边忘了补，
# 用户就会看到 git status 里凭空多一条自己没造过的文件（tests 里有一条测试在守这个同步）。
*_report.md
*_report.markdown
*_report.json
*_report.txt
*_report.text

# IDE
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db
